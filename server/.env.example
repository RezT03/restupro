# Server
PORT=3510
NODE_ENV=development
SITE_URL=https://restuproduction.com
TRUST_PROXY=false

# MySQL — database akan dibuat otomatis bila belum ada
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=restupro
DB_PASSWORD=ganti-dengan-password-mysql
DB_NAME=restupro

# Bootstrap admin — HANYA dipakai sekali saat tabel `admins` masih kosong.
# Setelah admin tersimpan di MySQL, baris-baris ini bisa dihapus.
# Kelola admin selanjutnya dengan: npm run admin -- list|add|password|email|remove
ADMIN_EMAIL=admin@restuproduction.com
# Buat hash dengan: cd server && npm run hash-password
# ADMIN_PASSWORD_HASH=scrypt$...
# Alternatif untuk development (min. 12 karakter):
# ADMIN_PASSWORD=password-yang-panjang

# Batas sesi & unggahan
SESSION_TTL_HOURS=8
MAX_UPLOADS=8
MAX_IMAGE_MB=15
MAX_VIDEO_MB=60
MAX_PDF_MB=10
